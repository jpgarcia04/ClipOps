# ─────────────────────────────────────────────────────────────
# ClipOps — PRODUCCIÓN (.env para el VPS)
#
# En el VPS:  cp .env.production.example .env  → y rellena los valores.
# Este archivo NUNCA se commitea con secretos reales.
#
# Genera secretos largos y aleatorios con:
#     openssl rand -base64 32
# ─────────────────────────────────────────────────────────────

# ---- Dominio / HTTPS (Caddy) ----
# Tu subdominio DuckDNS gratis (o un dominio propio cuando lo tengas).
# SIN https:// y SIN barra final.  Ej: clipops.duckdns.org
DOMAIN=clipops.duckdns.org
# Email para los avisos de Let's Encrypt (puede ser tu correo personal).
LETSENCRYPT_EMAIL=juanpagm04@gmail.com

# ---- URL pública de la app ----
# Debe coincidir con el dominio de arriba, CON https://
NEXT_PUBLIC_APP_URL=https://clipops.duckdns.org

# ---- PostgreSQL ----
POSTGRES_USER=clipops
# CAMBIA esto por una contraseña fuerte (openssl rand -base64 24).
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD
POSTGRES_DB=clipops

# ---- Auth (login por PIN) ----
# CAMBIA ambos por valores nuevos de `openssl rand -base64 32`.
# (No reutilices los de desarrollo.)
AUTH_SECRET=CAMBIA_ESTE_SECRETO
REGISTRATION_SECRET=CAMBIA_ESTE_CODIGO_DE_REGISTRO

# ---- Google Drive (Service Account) ----
# El MISMO JSON en base64 y la MISMA carpeta que ya usas en local.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
