// ─────────────────────────────────────────────────────────────
// ClipOps — Prisma schema
//
// Two top-level entities, intentionally kept separate:
//   • Clip — the base video asset (stored in Google Drive)
//   • Post — a single publication of a Clip on ONE platform
//
// Relationship: one Clip has many Posts (one per platform / attempt).
// Each Post accrues PostMetric snapshots over time (a time series).
// ─────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; the musl target covers the Alpine
  // container used in docker-compose / on the VPS.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Clip ───────────────────────────
// The base video. Everything starts here. The binary lives in Google
// Drive — the DB only stores metadata and a reference to the file.
model Clip {
  id          String      @id @default(cuid())
  title       String // título
  driveLink   String // link de Google Drive
  status      ClipStatus  @default(IDEA) // estado
  type        ClipType    @default(SHORT_FORM) // tipo
  duration    Int? // duración (en segundos)
  quality     ClipQuality @default(HD) // calidad
  notes       String? // notas
  tags        String[]    @default([]) // tags
  responsible String? // responsable

  // ── Google Drive (fuente de verdad; el binario nunca vive en la DB) ──
  driveFileId     String?    @unique // ID del archivo en Google Drive
  thumbnailUrl    String? // miniatura provista por Drive
  mimeType        String? // p.ej. video/mp4
  sizeBytes       Int? // tamaño del archivo (clips cortos << 2GB)
  driveModifiedAt DateTime? // última modificación en Drive (para el sync)

  // Dónde se planea publicar este clip (para saber "qué falta por subir").
  targetPlatforms Platform[] @default([])

  // A clip can be published as many posts (one per platform / attempt).
  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([responsible])
  @@map("clips")
}

// ─────────────────────────── Post ───────────────────────────
// A single publication of a Clip on a specific platform.
model Post {
  id     String @id @default(cuid())
  clipId String
  clip   Clip   @relation(fields: [clipId], references: [id], onDelete: Cascade)

  platform      Platform // plataforma
  caption       String? // caption
  hashtags      String[]   @default([]) // hashtags
  audio         String? // audio / canción usada
  status        PostStatus @default(DRAFT) // estado
  plannedDate   DateTime? // fecha planeada
  publishedDate DateTime? // fecha publicada
  url           String? // URL de la publicación
  externalId    String? // ID del post en la plataforma (para traer stats)
  responsible   String? // responsable
  notes         String? // notas

  // Métricas capturadas a lo largo del tiempo (serie temporal).
  metrics PostMetric[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clipId])
  @@index([status])
  @@index([platform])
  @@index([plannedDate])
  @@map("posts")
}

// ───────────────────────── PostMetric ─────────────────────────
// Snapshot de métricas de un Post en un momento dado (serie temporal).
// Permite ver la evolución y comparar qué clips/formatos rinden mejor.
model PostMetric {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  capturedAt DateTime @default(now()) // momento de la captura
  views      Int      @default(0)
  likes      Int      @default(0)
  comments   Int      @default(0)
  shares     Int      @default(0)
  saves      Int      @default(0)
  watchSec   Int? // tiempo de reproducción acumulado (segundos)

  @@index([postId])
  @@index([capturedAt])
  @@map("post_metrics")
}

// ─────────────────────────── Enums ──────────────────────────

// Lifecycle of a base video.
enum ClipStatus {
  IDEA
  RECORDING
  EDITING
  READY
  PUBLISHED
  ARCHIVED
}

// Kind of base video.
enum ClipType {
  SHORT_FORM
  LONG_FORM
  REEL
  STORY
  TUTORIAL
  INTERVIEW
  PROMO
  OTHER
}

// Technical quality / resolution of the base video.
enum ClipQuality {
  SD
  HD
  FULL_HD
  UHD_4K
}

// Platforms a post can target.
enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  YOUTUBE_SHORTS
  FACEBOOK
  X
  LINKEDIN
  THREADS
}

// Lifecycle of a single publication.
enum PostStatus {
  DRAFT
  READY
  SCHEDULED
  PUBLISHED
  FAILED
  ARCHIVED
}
