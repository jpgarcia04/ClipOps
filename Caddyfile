# ─────────────────────────────────────────────────────────────
# ClipOps — Caddy (reverse proxy + HTTPS automático)
#
# {$DOMAIN} y {$LETSENCRYPT_EMAIL} se leen de las variables de entorno
# que docker-compose.prod.yml le pasa al contenedor (vienen del .env).
#
# Caddy escucha en 80/443, saca y renueva solo el certificado de
# Let's Encrypt para el dominio, y reenvía todo a la app en el
# puerto 3000 dentro de la red interna de Docker.
# ─────────────────────────────────────────────────────────────

{
	# Email para Let's Encrypt (avisos de renovación). Opcional pero recomendado.
	email {$LETSENCRYPT_EMAIL}
}

{$DOMAIN} {
	# Reenvía el tráfico al contenedor de la app (nombre de servicio: app).
	reverse_proxy app:3000

	# Comprime las respuestas de texto (HTML/JS/CSS) — el video pasa sin comprimir.
	encode zstd gzip

	# Cabeceras de seguridad básicas.
	header {
		# HSTS: fuerza HTTPS en visitas futuras (1 año).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Evita que el navegador adivine tipos MIME.
		X-Content-Type-Options "nosniff"
		# Oculta la cabecera Server por defecto.
		-Server
	}

	# Logs de acceso a stdout (visibles con: docker compose logs caddy).
	log {
		output stdout
		format console
	}
}
