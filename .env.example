# ─────────────────────────────────────────────────────────────
# ClipOps — Environment variables
# Copy this file to `.env` and adjust the values:
#     cp .env.example .env
#
# NOTE: `docker compose up` works out of the box even without a
# .env file because docker-compose.yml ships with sensible
# defaults. Create a .env only to override them (recommended for
# a VPS) or to run the app locally with `npm run dev`.
# ─────────────────────────────────────────────────────────────

# ---- PostgreSQL (consumed by the `db` service in docker-compose) ----
POSTGRES_USER=clipops
POSTGRES_PASSWORD=clipops_dev_password
POSTGRES_DB=clipops
POSTGRES_PORT=5432

# ---- Database connection string (Prisma) ----
# LOCAL development (running `npm run dev` / prisma on the host):
#   use `localhost` as the host.
# Inside docker-compose the app container reaches Postgres at the
# `db` hostname automatically (set in docker-compose.yml), so you do
# NOT need to change this value for `docker compose up`.
DATABASE_URL=postgresql://clipops:clipops_dev_password@localhost:5432/clipops?schema=public

# ---- Next.js application ----
APP_PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Google Drive (Service Account) ----
# Mientras estén vacías, la app usa una fuente DEMO (clips de ejemplo).
# Para conectar Drive real:
#   1) JSON de la cuenta de servicio, codificado en base64.
#   2) ID de la carpeta de Drive (de la URL drive.google.com/drive/folders/<ID>).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
